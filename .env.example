# ===== Backend =====
NODE_ENV=development
PORT=3001

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://sigof:sigof@localhost:5432/sigof

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# Storage de anexos (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=sigof-anexos

# E-mail (SendGrid em produção / Mailtrap em dev)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=nao-responder@sigof.local

# Observabilidade
SENTRY_DSN=

# Regras de negócio
ANEXO_MAX_BYTES=5242880
ANEXO_MAX_POR_SOLICITACAO=10
DUPLICIDADE_JANELA_DIAS=7
SLA_INICIAL_HORAS=4

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
